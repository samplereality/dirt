{
  "name": "dirt",
  "version": "0.1.0",
  "private": true,
  "description": "Dirt \u2014 bury the web. Core module, browser extension, iOS targets and harnesses.",
  "type": "module",
  "scripts": {
    "serve": "node spike-0-core/serve.mjs 8080",
    "bench": "node spike-0-core/bench.mjs",
    "bench:phone": "node spike-0-core/bench.mjs --throttle 4",
    "fallback": "node spike-d-web-fallback/server.mjs",
