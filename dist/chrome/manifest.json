{
  "manifest_version": 3,
  "name": "Bury with Dirt",
  "version": "0.6",
  "description": "Buries the current page under shovelfuls of dirt, then lets a garden grow over it. Remembers each garden on this device. Draws on top of the page only; sends nothing anywhere.",
  "action": {
    "default_title": "Bury with Dirt"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "dirt-core.js",
        "shared.js",
        "autorestore.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "album.html",
    "open_in_tab": true
  }
}
