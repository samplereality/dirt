{
  "manifest_version": 3,
  "name": "Bury with Dirt",
  "version": "0.1",
  "description": "Buries the current page under shovelfuls of dirt, then lets a garden grow over it. Draws on top of the page only; collects nothing.",
  "action": {
    "default_title": "Bury with Dirt"
  },
  "permissions": ["activeTab", "scripting"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": { "id": "dirt@samplereality.com", "strict_min_version": "121.0" },
    "safari": { "strict_min_version": "16.4" }
  }
}
