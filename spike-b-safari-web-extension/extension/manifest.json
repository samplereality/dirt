{
  "manifest_version": 3,
  "name": "Bury with Dirt",
  "version": "0.4",
  "description": "Buries the current page under shovelfuls of dirt, then lets a garden grow over it. Remembers each garden on this device. Draws on top of the page only; sends nothing anywhere.",
  "action": {
    "default_title": "Bury with Dirt"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dirt@samplereality.com",
      "strict_min_version": "121.0"
    },
    "safari": {
      "strict_min_version": "16.4"
    }
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "dirt-core.js",
        "autorestore.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
